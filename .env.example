# คัดลอกเป็น .env แล้วใส่ค่าจริงในเครื่อง — ห้าม commit ไฟล์ .env
# ทั้งระบบอยู่ที่ Singapore (Bedrock Nova + QuickSight มีที่นี่) — region ที่ผู้จัดอนุญาต: us-east-1, ap-southeast-1, ap-southeast-7
AWS_REGION=ap-southeast-1
# ใช้ IAM role / credentials ชั่วคราวผ่าน AWS CLI profile แทนการใส่ key ในไฟล์
AWS_PROFILE=
# LLM (ขั้นที่ 4): mock = ไม่เรียกโมเดลจริง ใช้สำหรับเทส/เดโมออฟไลน์
LLM_PROVIDER=mock
# โมเดลของ Amazon (ไม่ต้อง subscribe ผ่าน Marketplace ซึ่งถูกบล็อก) — ใช้ model ID / inference profile ที่เห็นใน console
BEDROCK_MODEL_ID=
# ยังไม่ยืนยันว่ามี embedding model ใน ap-southeast-1 → เว้นว่าง = RAG ใช้ค้นตามคำ (lexical)
BEDROCK_EMBEDDING_MODEL_ID=
# ขีดจำกัดความปลอดภัยของ Agent
AGENT_MAX_ROUNDS=6
AGENT_LLM_TIMEOUT_MS=20000
AGENT_LLM_MAX_RETRIES=1
# LINE OA (ขั้นที่ 8)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ราคาอ้างอิงตลาด
NABC_BASE_URL=https://agriapi.nabc.go.th
NABC_TIMEOUT_MS=5000
